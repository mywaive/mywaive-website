---
/** The four pillars as colour-topped photo cards (Product, Figma "Design updates"). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Pillar { title: string; colour: string; photo: string; alt: string }
interface Props { items: Pillar[] }
const { items } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{png,jpg,jpeg,webp}', { eager: true });
const find = (name: string) => {
  const hit = Object.entries(photos).find(([p]) => p.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === name);
  if (!hit) throw new Error(`Photo "${name}" not found in src/assets/photos`);
  return hit[1].default;
};
---
<section class="section bg-white">
  <div class="container">
    <ul class="grid grid-4 m-2col" role="list" data-stagger>
      {items.map((p) => (
        <li class="pillar" style={`--card: ${p.colour}`} data-reveal>
          <h2 class="h1">{p.title}</h2>
          <Image src={find(p.photo)} alt={p.alt} widths={[320, 480, 640]} sizes="(min-width: 1080px) 280px, 50vw" loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>
<style>@import './PillarStrip.css';</style>
