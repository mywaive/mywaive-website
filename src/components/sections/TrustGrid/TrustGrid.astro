---
import { trust } from '@/data/copy';
import Icon from '@/components/ui/Icon/Icon.astro';
interface Props { headline?: string; intro?: string; limit?: number; id?: string; tone?: 'white' | 'muted' | 'dark' }
const { headline = 'Built for FCA-regulated environments', intro, limit, id = 'trust', tone = 'dark' } = Astro.props;
const items = limit ? trust.slice(0, limit) : trust;
---
<section class:list={['section', `bg-${tone}`, { 'on-dark': tone === 'dark' }]} id={id}>
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 class="h3">{headline}</h2>
      {intro && <p class="lead muted">{intro}</p>}
    </div>
    <ul class:list={['grid', items.length > 4 ? 'grid-3' : 'grid-4']} role="list" data-stagger>
      {items.map((t) => (
        <li class="trust tile-compact" data-reveal data-spotlight>
          <span class="icon-tile"><Icon name={t.icon} /></span>
          <h3 class="h0">{t.title}</h3>
          <p class="muted">{t.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>@import './TrustGrid.css';</style>
