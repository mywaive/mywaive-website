---
import { site } from '@/data/site';
import Button from '@/components/ui/Button/Button.astro';
import Icon from '@/components/ui/Icon/Icon.astro';
const endpoint = site.formEndpoint;
const roles = ['Pension scheme provider', 'Employer / corporate', 'Benefits provider', 'Adviser', 'Fintech', 'Other'];
const sizes = ['Under 1,000', '1,000-10,000', '10,000-100,000', '100,000-1 million', '1 million+'];
---
<form class="form card" method="POST" action={endpoint || undefined} data-contact-form data-live={endpoint ? 'true' : 'false'} novalidate>
  <div class="form-error" role="alert" hidden data-form-error tabindex="-1">
    <p class="form-error-title"><Icon name="error" fill /><span data-form-error-title>Please check the form</span></p>
    <ul class="form-error-list" role="list" data-form-error-list></ul>
  </div>
  <div class="form-grid">
    <div class="field"><label for="name">Full name <span aria-hidden="true">*</span></label><input id="name" name="name" type="text" autocomplete="name" required aria-required="true" /></div>
    <div class="field"><label for="email">Work email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-required="true" /></div>
    <div class="field"><label for="org">Organisation <span aria-hidden="true">*</span></label><input id="org" name="organisation" type="text" autocomplete="organization" required aria-required="true" /></div>
    <div class="field"><label for="role">I am a… <span aria-hidden="true">*</span></label><select id="role" name="role" required aria-required="true"><option value="">Please select</option>{roles.map((r) => <option>{r}</option>)}</select></div>
    <div class="field full"><label for="size">Approx. members or employees</label><select id="size" name="size"><option value="">Please select</option>{sizes.map((s) => <option>{s}</option>)}</select></div>
    <div class="field full"><label for="message">Message</label><textarea id="message" name="message" rows="4"></textarea></div>
    <div class="field full check">
      <input id="consent" name="consent" type="checkbox" required aria-required="true" />
      <label for="consent">I agree to myWaive processing my details as described in the <a href="/legal/privacy-policy">Privacy Policy</a>. <span aria-hidden="true">*</span></label>
    </div>
    <div class="visually-hidden" aria-hidden="true"><label for="_gotcha">Leave this field empty</label><input id="_gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
  </div>
  <div class="form-actions">
    <Button type="submit" size="lg" icon="send">Request a demo</Button>
    <p class="small muted">Required fields are marked <span class="req" aria-hidden="true">*</span></p>
  </div>
  <div class="form-success" hidden data-form-success tabindex="-1">
    <Icon name="check_circle" fill class="success-icon" />
    <h2 class="h1">Thanks - we’ll be in touch</h2>
    <p class="muted">We aim to reply within two working days. In the meantime, <a href="/product">see how the platform works</a>.</p>
  </div>
</form>

<style>@import './ContactForm.css';</style>

<script>import './ContactForm.ts';</script>
