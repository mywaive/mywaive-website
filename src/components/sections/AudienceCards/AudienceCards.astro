---
import { industries } from '@/data/site';
import Icon from '@/components/ui/Icon/Icon.astro';
import { Image } from 'astro:assets';
import { splitWords } from '@/utils/words';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{png,jpg,jpeg,webp}', { eager: true });
const findPhoto = (name?: string) => name ? Object.entries(photos).find(([p]) => p.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === name)?.[1].default : undefined;
type Item = { icon: string; title: string; text: string; href: string; cta?: string; photo?: string; alt?: string };
interface Props { eyebrow?: string | false; headline?: string; items?: Item[]; id?: string; tone?: 'muted' | 'white' | 'lilac' | 'ruby-tint'; variant?: 'photo' | 'plain'; align?: 'left' | 'center'; panelTone?: 'ruby-tint' | 'lilac' | false }
const defaults: Item[] = [
  { icon: 'account_balance', title: 'Pension Scheme Providers', text: 'Increase customer Lifetime Value and engage your members.', href: industries[0].href, photo: 'woman-floor-phone', alt: 'A scheme member at home checking her pension on her phone' },
  { icon: 'groups', title: 'Corporates & Employers', text: 'Increase employee engagement, maximise investment in your people, helping them achieve a better retirement outcome.', href: industries[1].href, photo: 'corporates-hero', alt: 'A warehouse employee checking their pension on a phone' },
  { icon: 'handshake', title: 'Benefits Providers', text: 'Enhance your corporate proposition with myWaive.', href: industries[2].href, photo: 'partners-hero', alt: 'A benefits consultant presenting to an HR team' },
];
const { eyebrow = 'Who it’s for', headline = 'Built for the people who look after savers', items = defaults, id = 'who-its-for', tone = 'white', variant = 'photo', align = 'left', panelTone = false } = Astro.props;
---
<section class:list={['section', `bg-${tone}`]} id={id}>
  <div class="container">
    <div class:list={['section-header', { center: align === 'center' }]} data-reveal>
      {eyebrow !== false && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="h3" style={`--n:${splitWords(headline).length}`}>{splitWords(headline).map((w, i) => <>{i > 0 && ' '}<span class="scrub-word" style={`--i:${i}`}>{w.map((p) => p.text)}</span></>)}</h2>
    </div>
    <ul class:list={['grid', 'grid-3', panelTone && `card-panel bg-${panelTone}`]} role="list" data-reveal>
      {items.map((a) => {
        const img = variant === 'photo' ? findPhoto(a.photo) : undefined;
        return img ? (
          <li class="aud aud-photo on-dark">
            <Image src={img} alt={a.alt ?? ''} widths={[480, 768, 1024]} sizes="(min-width: 1080px) 400px, (min-width: 600px) 50vw, 100vw" class="aud-img" loading="lazy" decoding="async" />
            <div class="aud-body">
              <h3 class="h1">{a.title}</h3>
              <p>{a.text}</p>
              <a class="aud-link" href={a.href}>{a.cta ?? 'Explore'}<span class="visually-hidden">: {a.title}</span><Icon name="arrow_forward" size={20} /></a>
            </div>
          </li>
        ) : (
          <li class="card aud">
            <span class="icon-tile"><Icon name={a.icon} /></span>
            <h3 class="h1">{a.title}</h3>
            <p>{a.text}</p>
            <a class="aud-link" href={a.href}>{a.cta ?? 'Explore'}<span class="visually-hidden">: {a.title}</span><Icon name="arrow_forward" size={20} /></a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>@import './AudienceCards.css';</style>
