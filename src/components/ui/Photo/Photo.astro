---
/**
 * Photo slot. Renders the generated/licensed image from src/assets/photos/<name>.{png,jpg,webp} when it exists,
 * otherwise the branded ImagePlaceholder carrying the photo brief. Generate images with scripts/images/generate.mjs.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder/ImagePlaceholder.astro';
interface Props { name: string; alt: string; ratio?: string; tone?: 'light' | 'dark' | 'brand'; icon?: string; class?: string; eager?: boolean; widths?: number[] }
const { name, alt, ratio = '4 / 5', tone = 'light', icon = 'person', class: cls = '', eager = false, widths = [480, 768, 1024, 1536] } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{png,jpg,jpeg,webp}', { eager: true });
const match = Object.entries(photos).find(([p]) => p.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === name)?.[1].default;
---
{match
  ? <Image src={match} alt={alt} widths={widths} sizes="(min-width: 1080px) 520px, 100vw" class:list={['photo', cls]} style={`aspect-ratio:${ratio}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  : <ImagePlaceholder alt={alt} ratio={ratio} tone={tone} icon={icon} class={cls} />}
<style>@import './Photo.css';</style>
