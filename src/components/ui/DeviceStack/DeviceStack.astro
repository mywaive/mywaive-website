---
/** Multi-channel view (feedback #012, #116): laptop + tablet + phone, each showing a product screen. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneFrame from '@/components/ui/PhoneFrame/PhoneFrame.astro';
interface Props { phone: string; laptop?: string; tablet?: string; alt: string; eager?: boolean }
const { phone, laptop = 'figma-dashboard', tablet = 'figma-fund-review', alt, eager = false } = Astro.props;
const screens = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screens/*.png', { eager: true });
const get = (name: string) => {
  const src = screens[`/src/assets/screens/${name}.png`]?.default;
  if (!src) throw new Error(`Screen "${name}" not found in src/assets/screens`);
  return src;
};
const loading = eager ? 'eager' : 'lazy';
---
<figure class="devices" aria-label={alt}>
  <div class="laptop" aria-hidden="true">
    <div class="laptop-screen"><Image src={get(laptop)} alt="" widths={[480, 720, 960]} sizes="(min-width: 1080px) 420px, 70vw" loading={loading} decoding="async" /></div>
    <div class="laptop-base"></div>
  </div>
  <div class="tablet" aria-hidden="true"><Image src={get(tablet)} alt="" widths={[320, 480, 640]} sizes="(min-width: 1080px) 240px, 40vw" loading={loading} decoding="async" /></div>
  <div class="phone-slot" aria-hidden="true"><PhoneFrame screen={phone} alt="" width={400} eager={eager} /></div>
</figure>
<style>@import './DeviceStack.css';</style>
