---
/** Minimal consent banner. Only essential cookies today; keep in step with /legal/cookie-policy. */
---
<div class="cookie" data-cookie hidden role="region" aria-label="Cookie notice">
  <p class="small">We use essential cookies to make this site work. We don’t use advertising cookies. <a href="/legal/cookie-policy">Cookie Policy</a></p>
  <div class="cookie-actions">
    <button type="button" class="cookie-btn cookie-accept" data-cookie-accept>OK</button>
  </div>
</div>
<style>@import './CookieBanner.css';</style>
<script>import './CookieBanner.ts';</script>
