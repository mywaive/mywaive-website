---
/* Rebuilt from the Figma About wireframe (node 66:6747). Headers and illustrations are as drawn. */
import PageLayout from '@/layouts/PageLayout.astro';
import IllustrationCards from '@/components/sections/IllustrationCards/IllustrationCards.astro';
import PeopleGrid from '@/components/sections/PeopleGrid/PeopleGrid.astro';
import BrowserFrame from '@/components/ui/BrowserFrame/BrowserFrame.astro';
---
<PageLayout
  title="About myWaive"
  description="myWaive was founded by wealth and pensions professionals to close the UK advice gap. Meet the team and advisory board behind myWaive."
  cta={false}
>
  <!-- Layout from the Figma "Design updates" file (About, 0:516); Impact Builder video under the hero copy (#033). -->
  <section class="section bg-mint dotted about-hero">
    <div class="container">
      <div class="about-hero-copy">
        <h1 class="h4">We are closing the advice gap in pensions and savings</h1>
        <p class="lead">Founded by pensions and technology professionals who believe financial advice should be inclusive, affordable, accessible and personalised for everyone.</p>
      </div>
      <!-- preload="none": the 6 MB file only downloads when someone presses play -->
      <video data-reveal class="about-video" controls playsinline preload="none" poster="/media/impact-builder-founder-story.jpg" aria-label="Impact Builder Founder Story Series: myWaive">
        <source src="/media/impact-builder-founder-story.mp4" type="video/mp4" />
        <track kind="captions" src="/media/impact-builder-founder-story.en.vtt" srclang="en" label="English" default />
      </video>
    </div>
  </section>

  <section class="section origins">
    <div class="container origins-grid" data-stagger>
      <div class="origins-copy" data-reveal>
        <h2 class="h3">Origins of myWaive</h2>
        <p class="lead">Designed by a team with extensive industry experience and a clear ambition: to create a future where everyone can make confident financial decisions with access to trusted, affordable, regulated advice.</p>
      </div>
      <div class="origins-visual" data-reveal>
        <div class="origins-block" aria-hidden="true"></div>
        <div class="origins-frame"><BrowserFrame screen="figma-dashboard" alt="myWaive dashboard - pension value and what to do next" sizes="(min-width: 1080px) 600px, 100vw" /></div>
      </div>
    </div>
  </section>

  <section class="section bg-brand people-band">
    <div class="container">
      <PeopleGrid collection={['team', 'advisors']} headline="The myWaive Leadership Team" columns={4} />
    </div>
  </section>

  <IllustrationCards
    tone="muted"
    dotted
    headline="Why choose myWaive"
    cards={[
      { illustration: 'inclusive', colour: '#81b4fc', title: 'Inclusive' },
      { illustration: 'personalised', colour: '#c5b1f9', title: 'Personalised' },
      { illustration: 'always-on', colour: '#96fce4', title: 'Always on' },
      { illustration: 'accountable', colour: '#ffb1d1', title: 'Affordable' },
    ]}
  />
</PageLayout>

<style>@import '../styles/pages/about.css';</style>
