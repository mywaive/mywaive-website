# Contact form delivery
# The form posts to the site's own /api/contact handler (scripts/contact.mjs), which
# emails each enquiry. Set these on the host (e.g. GoDaddy cPanel > Node.js app > env vars).
# To post to an external provider (e.g. Formspree) instead, set PUBLIC_FORM_ENDPOINT to its URL.

# Where enquiries are emailed. Comma-separate for multiple recipients.
CONTACT_TO=jchapman@mywaive.io, james@mywaive.io, hello@mywaive.io
# Must be an address you are authorised to send as (match the SMTP login's domain), or mail gets junked.
CONTACT_FROM=myWaive website <hello@mywaive.io>

# SMTP. RECOMMENDED: an authenticated GoDaddy mailbox. It is DKIM-signed and SPF-aligned, so it
# reaches inboxes reliably (and delivers intra-domain mail without leaving GoDaddy's mail system).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@mywaive.io
SMTP_PASS=your-mailbox-password
# SMTP_SECURE=true          # force TLS; otherwise inferred (true when SMTP_PORT=465)
#
# ALTERNATIVE: GoDaddy's internal relay — no login, but GoDaddy-hosting only and poor deliverability
# (frequently dropped or spam-filtered; this is likely why a test mail did not arrive). Not recommended.
# SMTP_HOST=relay-hosting.secureserver.net
# SMTP_PORT=25

# Optional: override the form's post URL (build time; written into the HTML).
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Image generation (Atlas Cloud, https://www.atlascloud.ai/console/api-keys). Used only by `npm run images`.
ATLASCLOUD_API_KEY=
