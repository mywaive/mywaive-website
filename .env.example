# Contact form delivery
# The form posts to the site's own /api/contact handler (scripts/contact.mjs), which
# emails each enquiry. Set these on the host (e.g. GoDaddy cPanel > Node.js app > env vars).
# To post to an external provider (e.g. Formspree) instead, set PUBLIC_FORM_ENDPOINT to its URL.

# Where enquiries are emailed.
CONTACT_TO=hello@mywaive.io
CONTACT_FROM=myWaive website <hello@mywaive.io>

# SMTP. Default (below) is GoDaddy's internal relay: no login, but only works from GoDaddy
# hosting. For better deliverability, use an authenticated mailbox and set SMTP_USER/SMTP_PASS
# (GoDaddy email: SMTP_HOST=smtpout.secureserver.net, SMTP_PORT=465).
SMTP_HOST=relay-hosting.secureserver.net
SMTP_PORT=25
# SMTP_USER=hello@mywaive.io
# SMTP_PASS=
# SMTP_SECURE=true          # force TLS; otherwise inferred (true when SMTP_PORT=465)

# Optional: override the form's post URL (build time; written into the HTML).
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Image generation (Atlas Cloud, https://www.atlascloud.ai/console/api-keys). Used only by `npm run images`.
ATLASCLOUD_API_KEY=
