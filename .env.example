# Contact form delivery
# The form posts to the site's own /api/contact handler (scripts/contact.mjs), which
# emails each enquiry. Set these on the host (e.g. GoDaddy cPanel > Node.js app > env vars).
# To post to an external provider (e.g. Formspree) instead, set PUBLIC_FORM_ENDPOINT to its URL.

# Where enquiries are emailed. Comma-separate for multiple recipients.
CONTACT_TO=jchapman@mywaive.io, james@mywaive.io, hello@mywaive.io
# The mailbox the enquiry is sent AS. Must be the one Graph/SMTP is authorised to send from
# (jchapman@). Replies go to the enquirer via Reply-To, so this is just the notification sender.
CONTACT_FROM=myWaive website <jchapman@mywaive.io>

# ── Delivery: Microsoft Graph (PREFERRED) ─────────────────────────────────────────────────
# The 365 tenant blocks basic-auth SMTP (no app passwords available), so send via Graph with
# app-only OAuth. One-time Entra ID (Azure AD) setup, then paste the three values here:
#   1. Entra admin centre > App registrations > New registration (single tenant).
#   2. API permissions > Microsoft Graph > Application permissions > Mail.Send > Grant admin consent.
#   3. Certificates & secrets > New client secret (store the VALUE now; it is shown once).
#   4. Recommended: scope sending to just this mailbox with an ApplicationAccessPolicy (see docs),
#      otherwise the app can send as any mailbox in the tenant.
# When these are set, the SMTP_* vars below are ignored.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=jchapman@mywaive.io      # mailbox to send as (defaults to the CONTACT_FROM address)

# ── Delivery: SMTP (FALLBACK) ─────────────────────────────────────────────────────────────
# Used only when GRAPH_* above is unset. Microsoft 365 basic-auth SMTP (smtp.office365.com:587)
# will NOT work on this tenant. Use a transactional provider instead, e.g.:
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587  SMTP_USER=apikey        SMTP_PASS=<api key>
#   Postmark:  SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587 SMTP_USER=<token>       SMTP_PASS=<token>
#   Resend:    SMTP_HOST=smtp.resend.com      SMTP_PORT=465 SMTP_USER=resend        SMTP_PASS=<api key>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true          # force implicit TLS; otherwise inferred (true only when SMTP_PORT=465)
# SMTP_JSON=true            # local dev only: compose each message but do not send it

# Optional: override the form's post URL (build time; written into the HTML).
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Image generation (Atlas Cloud, https://www.atlascloud.ai/console/api-keys). Used only by `npm run images`.
ATLASCLOUD_API_KEY=
