# Contact form delivery (Formspree). Create a form at https://formspree.io, then paste its endpoint here.
# The form stays in "not connected" mode until this is set.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Image generation (Atlas Cloud, https://www.atlascloud.ai/console/api-keys). Used only by `npm run images`.
ATLASCLOUD_API_KEY=
