{
  "name": "my-waive",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "qa": "OUT=qa-output node scripts/qa.mjs",
    "images": "node scripts/images/generate.mjs",
    "serve:dist": "node scripts/serve-dist.mjs dist vercel.json",
    "qa:dist": "BASE=http://localhost:4400 OUT=qa-output node scripts/qa.mjs",
    "ui-audit": "BASE=http://localhost:4400 node scripts/ui-audit.mjs",
    "deploy": "astro build && npx --yes vercel deploy --prod --yes",
    "deploy:preview": "astro build && npx --yes vercel deploy --yes"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "astro": "^7.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify/utils": "^3.1.7",
    "axe-core": "^4.13.0",
    "playwright": "1.49",
    "typescript": "^6.0.3"
  }
}
